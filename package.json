{
  "name": "rt-press",
  "productName": "RT Press",
  "version": "0.1.0-alpha.0",
  "description": "Designed print interiors and cover wraps, checked against the printer's rules, for Windows, macOS and Linux.",
  "author": "Recon Towers Dev Department <author@neogentrics.com>",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"test/*.test.cjs\"",
    "test:e2e": "npm run fetch:typst:current && npm run build:renderer && node test/e2e/app.e2e.cjs",
    "dist:win": "npm run fonts:stand-in && npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run fonts:stand-in && npm run build:renderer && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:linux": "npm run fonts:stand-in && npm run build:renderer && electron-builder --linux AppImage deb --x64 --publish never",
    "fetch:typst": "node scripts/fetch-typst.mjs",
    "fetch:typst:current": "node scripts/fetch-typst.mjs --current",
    "fonts:stand-in": "node scripts/prepare-fonts.mjs",
    "icons": "node scripts/make-icons.mjs",
    "locales": "node scripts/make-locales.mjs"
  },
  "build": {
    "appId": "com.recontowers.press",
    "productName": "RT Press",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "src/shared/**",
      "src/locales/*.json",
      "dist/renderer/**",
      "build/icon.png",
      "help/**",
      "package.json",
      "LICENSE",
      "!node_modules/node-addon-api/**",
      "!node_modules/better-sqlite3-multiple-ciphers/deps/**",
      "!node_modules/better-sqlite3-multiple-ciphers/src/**",
      "!node_modules/better-sqlite3-multiple-ciphers/binding.gyp"
    ],
    "copyright": "Copyright © 2026 Recon Towers. All rights reserved.",
    "win": {
      "target": [
        "nsis"
      ],
      "files": [
        "src/main/**",
        "src/shared/**",
        "src/locales/*.json",
        "dist/renderer/**",
        "build/icon.png",
        "help/**",
        "package.json",
        "LICENSE",
        "!node_modules/node-addon-api/**",
        "!node_modules/better-sqlite3-multiple-ciphers/deps/**",
        "!node_modules/better-sqlite3-multiple-ciphers/src/**",
        "!node_modules/better-sqlite3-multiple-ciphers/binding.gyp",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-arm64.node"
      ],
      "extraResources": [
        {
          "from": "vendor/typst/win32-${arch}",
          "to": "typst"
        },
        {
          "from": "vendor/fonts/stand-in",
          "to": "fonts"
        },
        {
          "from": "licenses",
          "to": "licenses"
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "THIRD_PARTY_NOTICES.md"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RT Press",
      "license": "LICENSE",
      "artifactName": "RTPress-${version}-Setup.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "files": [
        "src/main/**",
        "src/shared/**",
        "src/locales/*.json",
        "dist/renderer/**",
        "build/icon.png",
        "help/**",
        "package.json",
        "LICENSE",
        "!node_modules/node-addon-api/**",
        "!node_modules/better-sqlite3-multiple-ciphers/deps/**",
        "!node_modules/better-sqlite3-multiple-ciphers/src/**",
        "!node_modules/better-sqlite3-multiple-ciphers/binding.gyp",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*"
      ],
      "extraResources": [
        {
          "from": "vendor/typst/darwin-${arch}",
          "to": "typst"
        },
        {
          "from": "vendor/fonts/stand-in",
          "to": "fonts"
        },
        {
          "from": "licenses",
          "to": "licenses"
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "THIRD_PARTY_NOTICES.md"
        }
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "artifactName": "RTPress-${version}-mac-${arch}.dmg"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "RTPress-${version}-linux-${arch}.${ext}",
      "maintainer": "Recon Towers Dev Department <author@neogentrics.com>",
      "synopsis": "Designed print interiors and cover wraps, checked against the printer's rules",
      "files": [
        "src/main/**",
        "src/shared/**",
        "src/locales/*.json",
        "dist/renderer/**",
        "build/icon.png",
        "help/**",
        "package.json",
        "LICENSE",
        "!node_modules/node-addon-api/**",
        "!node_modules/better-sqlite3-multiple-ciphers/deps/**",
        "!node_modules/better-sqlite3-multiple-ciphers/src/**",
        "!node_modules/better-sqlite3-multiple-ciphers/binding.gyp",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*arm64.node"
      ],
      "extraResources": [
        {
          "from": "vendor/typst/linux-${arch}",
          "to": "typst"
        },
        {
          "from": "vendor/fonts/stand-in",
          "to": "fonts"
        },
        {
          "from": "licenses",
          "to": "licenses"
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "THIRD_PARTY_NOTICES.md"
        }
      ],
      "syncDesktopName": true,
      "icon": "build/icons"
    },
    "deb": {
      "packageCategory": "text"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "neogentrics",
        "repo": "rt-press",
        "releaseType": "release",
        "channel": "latest"
      }
    ]
  },
  "homepage": "https://github.com/neogentrics/rt-press",
  "bugs": "https://github.com/neogentrics/rt-press/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/neogentrics/rt-press.git"
  },
  "desktopName": "rt-press.desktop"
}
